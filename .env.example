# Required at runtime. Set your own password before starting Compose.
ADMIN_PASSWORD=

# Public Naver Maps key ID, embedded during the image build.
# This is the ONLY Naver Maps credential the browser needs. The client secret
# that comes with it is for server-side REST APIs (geocoding, directions) and
# must never be exposed as a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_NAVER_CLIENT_ID=

# Auth parameter for the maps script: "ncpKeyId" (current NCP console, default)
# or "ncpClientId" (legacy AI·NAVER API console keys).
NEXT_PUBLIC_NAVER_MAP_AUTH_PARAM=ncpKeyId

# Host port; the container always listens on port 3000.
WEB_PORT=3000

# Optional external Redis. Leave blank to use the persistent popup-data volume.
REDIS_URL=
REDIS_PASSWORD=

# Required. Canonical origin baked into canonical URLs, robots.txt, sitemap.xml
# and JSON-LD at build time. The Compose build fails if it is missing.
NEXT_PUBLIC_SITE_URL=https://danaul.kdocai.com

# Optional. Search console ownership tokens, rendered as verification meta tags.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Signs admin session tokens; defaults to ADMIN_PASSWORD.
# Change it to invalidate every issued admin session.
ADMIN_SESSION_SECRET=
